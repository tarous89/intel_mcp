FROM python:3.11-slim-bookworm

# Keep Chromium's sandbox installed and enabled; the worker never runs as root.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium chromium-sandbox fonts-liberation ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 worker

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MAX_AGENT_CHROMIUM=/usr/bin/chromium
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .
COPY deploy/check_exports.py ./deploy/check_exports.py
USER worker

# Startup validation uses synthetic local files and a read-only account check.
# No session, model turn, or queue claim occurs until all checks pass.
CMD ["/bin/sh", "-c", "python deploy/check_exports.py && intel-max-worker --preflight && exec intel-max-worker"]
