{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filtering_variables",
    "classification_variables",
    "ctis_lifecycle",
    "results"
  ],
  "properties": {
    "results": {
      "type": "object",
      "description": "Compact final-pass extraction from the canonical results-summary document only.",
      "additionalProperties": false,
      "required": [
        "participant_flow",
        "country_enrollment",
        "primary_endpoint_results",
        "major_secondary_endpoint_results",
        "serious_safety_results",
        "other_results",
        "early_termination_reason",
        "trial_operational_findings"
      ],
      "properties": {
        "participant_flow": {
          "type": "object",
          "description": "Reported aggregate participant counts; null when a count is not stated.",
          "additionalProperties": false,
          "required": [
            "screened",
            "enrolled",
            "randomized",
            "completed"
          ],
          "properties": {
            "screened": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "enrolled": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "randomized": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "completed": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "country_enrollment": {
          "type": "array",
          "description": "Actual enrollment by country when explicitly reported.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "country_code",
              "enrolled"
            ],
            "properties": {
              "country_code": {
                "$ref": "#/$defs/country_code"
              },
              "enrolled": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "primary_endpoint_results": {
          "type": "array",
          "description": "Every reported primary or co-primary endpoint, one concise result sentence each.",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/endpoint_result"
          }
        },
        "major_secondary_endpoint_results": {
          "type": "array",
          "description": "Only major secondary endpoint results, one concise result sentence each.",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/endpoint_result"
          }
        },
        "serious_safety_results": {
          "type": "array",
          "description": "Aggregated high-impact safety findings only; each distinct finding is one sentence and never one item per participant or event.",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "other_results": {
          "type": "array",
          "description": "At most two planning-relevant findings not covered elsewhere, such as a key PK/PD result.",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "early_termination_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "One sentence only when the overall trial was stopped early; excludes individual discontinuation and withdrawal reasons."
        },
        "trial_operational_findings": {
          "type": "array",
          "description": "Explicit planning-relevant recruitment, geography, country, site, CRO, eligibility, disease, endpoint-feasibility, participant-burden, or protocol-change findings; one distinct finding per one-sentence item.",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "filtering_variables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_extracted_documents",
        "inclusion_criteria",
        "exclusion_criteria",
        "therapeutic_areas",
        "rare_disease_trial",
        "orphan_designation",
        "paediatric_trial",
        "first_in_human",
        "phase",
        "modality",
        "routes_of_administration",
        "country_codes",
        "eligible_sexes",
        "planned_sample_size",
        "number_of_countries",
        "number_of_sites",
        "allocation",
        "masking",
        "intervention_model",
        "comparator_types"
      ],
      "properties": {
        "available_extracted_documents": {
          "type": "object",
          "description": "Document names with successful or partial non-empty extracted text, grouped under the six fixed categories. Each name is accepted by get_documents and resolves to extracted text, never to a PDF or storage object. Deterministic; never model-generated.",
          "additionalProperties": false,
          "required": [
            "protocol",
            "recruitment_arrangements",
            "patient_information_and_informed_consent",
            "assessments_and_forms",
            "clinical_study_report",
            "results_summary"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/extracted_document_names"
            },
            "recruitment_arrangements": {
              "$ref": "#/$defs/extracted_document_names"
            },
            "patient_information_and_informed_consent": {
              "$ref": "#/$defs/extracted_document_names"
            },
            "assessments_and_forms": {
              "$ref": "#/$defs/extracted_document_names"
            },
            "clinical_study_report": {
              "$ref": "#/$defs/extracted_document_names"
            },
            "results_summary": {
              "$ref": "#/$defs/extracted_document_names"
            }
          }
        },
        "inclusion_criteria": {
          "type": "array",
          "description": "Principal inclusion criteria copied in source order from the structured CTIS record. Deterministic; never model-generated.",
          "items": {
            "type": "string"
          }
        },
        "exclusion_criteria": {
          "type": "array",
          "description": "Principal exclusion criteria copied in source order from the structured CTIS record. Deterministic; never model-generated.",
          "items": {
            "type": "string"
          }
        },
        "therapeutic_areas": {
          "type": "array",
          "description": "Every applicable controlled therapeutic area. Examples: prostate cancer must include both Solid Tumor Oncology and Urology; Crohn's disease must include both Immunology and Gastroenterology; non-malignant bleeding and clotting disorders must include Blood Disorders; gynecologic conditions must include Gynecology.",
          "items": {
            "$ref": "#/$defs/therapeutic_area"
          }
        },
        "rare_disease_trial": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Return true only if rare disease is explicitly mentioned in the trial protocol or other documents; otherwise return false."
        },
        "orphan_designation": {
          "type": "boolean",
          "description": "True only when an orphan designation is explicitly stated in the supplied trial context; otherwise false."
        },
        "paediatric_trial": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True when participants younger than 18 are eligible; false when explicitly restricted to adults; otherwise null."
        },
        "first_in_human": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True only when explicitly described as first-in-human, first-in-man, or first administration to humans; false only when previous human exposure is established; otherwise null."
        },
        "phase": {
          "type": "array",
          "description": "Trial phase as integer components 1 through 4; combined phases are split into multiple integers. Use [] when phase is not applicable or unavailable.",
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "routes_of_administration": {
          "type": "array",
          "description": "Every applicable normalized route of administration.",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "country_codes": {
          "type": "array",
          "description": "ISO 3166-1 alpha-2 code of every country in which the trial is submitted, planned, authorized, active, or conducted.",
          "items": {
            "$ref": "#/$defs/country_code"
          }
        },
        "eligible_sexes": {
          "type": "array",
          "description": "Every eligible sex using the controlled vocabulary.",
          "items": {
            "$ref": "#/$defs/eligible_sex"
          }
        },
        "planned_sample_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Total planned trial participant count as an integer, or null."
        },
        "number_of_countries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Number of unique trial countries as an integer, or null."
        },
        "number_of_sites": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Total number of identified trial sites as an integer, or null."
        },
        "allocation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Randomised",
            "Non-randomised",
            "Not applicable",
            null
          ]
        },
        "masking": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Open label",
            "Single blind",
            "Double blind",
            "Triple blind",
            "Quadruple blind",
            "Other",
            null
          ]
        },
        "intervention_model": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Parallel",
            "Single group",
            "Crossover",
            "Factorial",
            "Sequential",
            "Other",
            null
          ]
        },
        "comparator_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparator_type"
          }
        },
        "modality": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Small molecule",
            "Monoclonal antibody",
            "Bispecific antibody",
            "ADC",
            "Other antibody",
            "Cell therapy",
            "Gene therapy",
            "mRNA",
            "Oligonucleotide",
            "Other RNA",
            "Peptide/protein/enzyme",
            "Vaccine",
            "Radiopharmaceutical",
            "Diagnostic agent",
            "Other biologic",
            "Medical device",
            "Procedure",
            "Other",
            null
          ],
          "description": "Single most specific modality of the main tested IMP. When multiple tested IMPs exist, prioritize a non-approved investigational IMP; if still ambiguous, use the primary experimental intervention."
        }
      }
    },
    "ctis_lifecycle": {
      "type": "object",
      "description": "Deterministic chronological CTIS milestones and country updates. This section is never model-generated.",
      "additionalProperties": false,
      "required": [
        "overall_updates",
        "countries"
      ],
      "properties": {
        "overall_updates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ctis_overall_update"
          }
        },
        "countries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ctis_country_lifecycle"
          }
        }
      }
    },
    "classification_variables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_title",
        "trial_acronym",
        "diseases",
        "target_population_summary",
        "disease_stages_or_severity",
        "treatment_settings",
        "population_characteristics",
        "biomarkers",
        "molecular_targets",
        "mechanisms_of_action",
        "interventional_products",
        "non_interventional_products",
        "primary_objectives",
        "secondary_objectives",
        "endpoints",
        "sponsor",
        "legal_representative",
        "trial_management_contact",
        "trial_scientific_contact",
        "trial_recruitment_contact",
        "trial_public_ctis_contact",
        "third_party_organizations",
        "countries",
        "sites",
        "classification_summary"
      ],
      "properties": {
        "trial_title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Official trial title in English or the clearest available title."
        },
        "trial_acronym": {
          "type": [
            "string",
            "null"
          ],
          "description": "Official trial acronym, or null."
        },
        "diseases": {
          "type": "array",
          "description": "Normalized names of the investigated diseases and meaningful subtypes. Excludes incidental comorbidities, adverse events, and exclusion conditions.",
          "items": {
            "type": "string"
          }
        },
        "target_population_summary": {
          "type": [
            "string",
            "null"
          ],
          "description": "Concise description of the studied population, including disease context, stage or severity, treatment history, biomarker requirements, and other defining characteristics."
        },
        "disease_stages_or_severity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "treatment_settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treatment_setting"
          }
        },
        "population_characteristics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "biomarkers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "molecular_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mechanisms_of_action": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interventional_products": {
          "type": "array",
          "description": "The scientifically tested product or complete tested combination. Each combination component remains a separate nested entity.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "product_type",
              "components"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Concise name of one tested product or complete tested combination."
              },
              "product_type": {
                "type": "string",
                "enum": [
                  "Single product",
                  "Combination"
                ]
              },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "active_substances",
                    "component_role",
                    "approval_status_for_studied_indication",
                    "ctis_product_role",
                    "alternative_group_id",
                    "modalities"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "active_substances": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "component_role": {
                      "type": "string",
                      "enum": [
                        "Tested component",
                        "Combination partner"
                      ]
                    },
                    "approval_status_for_studied_indication": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "Approved",
                        "Not approved",
                        null
                      ]
                    },
                    "ctis_product_role": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "IMP",
                        "Auxiliary medicinal product",
                        "Other",
                        null
                      ]
                    },
                    "alternative_group_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "modalities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/modality"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "non_interventional_products": {
          "type": "array",
          "description": "Controls, standard of care, non-tested background, supportive, prophylactic, rescue, and other products outside the scientifically tested product or combination.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "active_substances",
              "role",
              "approval_status_for_studied_indication",
              "ctis_product_role",
              "modalities"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "active_substances": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "role": {
                "type": "string",
                "enum": [
                  "Comparator",
                  "Control",
                  "Standard of care",
                  "Background therapy",
                  "Supportive therapy",
                  "Prophylactic therapy",
                  "Rescue therapy",
                  "Other"
                ]
              },
              "approval_status_for_studied_indication": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "Approved",
                  "Not approved",
                  null
                ]
              },
              "ctis_product_role": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "IMP",
                  "Auxiliary medicinal product",
                  "Other",
                  null
                ]
              },
              "modalities": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/modality"
                }
              }
            }
          }
        },
        "primary_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondary_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_endpoints",
            "secondary_endpoints",
            "other_endpoints"
          ],
          "properties": {
            "primary_endpoints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "secondary_endpoints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "other_endpoints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sponsor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "organisation_type",
            "country_code"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "organisation_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Sponsor organisation type copied verbatim from structured CTIS data, such as academic or industry, or null."
            },
            "country_code": {
              "anyOf": [
                {
                  "$ref": "#/$defs/country_code"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "legal_representative": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "organisation_type",
            "country_code",
            "contact"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "organisation_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "country_code": {
              "anyOf": [
                {
                  "$ref": "#/$defs/country_code"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contact": {
              "$ref": "#/$defs/trial_contact"
            }
          }
        },
        "trial_management_contact": {
          "$ref": "#/$defs/trial_contact"
        },
        "trial_scientific_contact": {
          "$ref": "#/$defs/trial_contact"
        },
        "trial_recruitment_contact": {
          "$ref": "#/$defs/trial_contact"
        },
        "trial_public_ctis_contact": {
          "$ref": "#/$defs/trial_contact"
        },
        "third_party_organizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "organisation_type",
              "function",
              "contact_first_name",
              "contact_last_name",
              "email",
              "country_code"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "organisation_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Organisation type copied verbatim from structured CTIS data, or null."
              },
              "function": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "contact_first_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "contact_last_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country_code": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/country_code"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "country_code",
              "number_of_sites",
              "planned_sample_size"
            ],
            "properties": {
              "country_code": {
                "$ref": "#/$defs/country_code"
              },
              "number_of_sites": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "planned_sample_size": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "country_code",
              "planned_sample_size",
              "investigators"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "country_code": {
                "$ref": "#/$defs/country_code"
              },
              "planned_sample_size": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "investigators": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "first_name",
                    "last_name",
                    "email",
                    "department_or_division",
                    "function"
                  ],
                  "properties": {
                    "first_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "last_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "email": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "department_or_division": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Explicit department, service, unit, or division associated with this investigator at this site."
                    },
                    "function": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "classification_summary": {
          "type": [
            "string",
            "null"
          ],
          "description": "Two-to-four-sentence factual summary of what is being studied, in whom, with which interventions, and in what disease or treatment setting."
        }
      }
    }
  },
  "$defs": {
    "endpoint_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "result"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 750,
          "description": "One concise sentence combining the numerical and descriptive result, including uncertainty or statistical significance when reported."
        }
      }
    },
    "therapeutic_area": {
      "type": "string",
      "enum": [
        "Solid Tumor Oncology",
        "Haematological Malignancies",
        "Blood Disorders",
        "Cardiology",
        "Neurology",
        "Immunology",
        "Rheumatology",
        "Allergy",
        "Infectious Disease",
        "Endocrinology",
        "Metabolic Disorders",
        "Respiratory",
        "Gastroenterology",
        "Hepatology",
        "Dermatology",
        "Musculoskeletal",
        "Ophthalmology",
        "Otolaryngology",
        "Oral Health and Dentistry",
        "Nephrology",
        "Psychiatry",
        "Pain Medicine",
        "Gynecology",
        "Obstetrics",
        "Reproductive Medicine",
        "Urology",
        "Emergency Medicine",
        "Critical Care",
        "Surgery and Perioperative Care",
        "Transplantation",
        "Trauma and Injury",
        "Genetic and Congenital Disorders",
        "Nutrition",
        "Other"
      ]
    },
    "phase": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "modality": {
      "type": "string",
      "enum": [
        "Small molecule",
        "Monoclonal antibody",
        "Bispecific antibody",
        "ADC",
        "Other antibody",
        "Cell therapy",
        "Gene therapy",
        "mRNA",
        "Oligonucleotide",
        "Other RNA",
        "Peptide/protein/enzyme",
        "Vaccine",
        "Radiopharmaceutical",
        "Diagnostic agent",
        "Other biologic",
        "Medical device",
        "Procedure",
        "Other"
      ]
    },
    "route": {
      "type": "string",
      "enum": [
        "Oral",
        "Intravenous",
        "Subcutaneous",
        "Intramuscular",
        "Intratumoral",
        "Inhaled",
        "Topical",
        "Ophthalmic",
        "Intrathecal",
        "Other"
      ]
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "eligible_sex": {
      "type": "string",
      "enum": [
        "Female",
        "Male"
      ]
    },
    "comparator_type": {
      "type": "string",
      "enum": [
        "Placebo",
        "Active comparator",
        "Standard of care",
        "Historical control",
        "External or real-world control",
        "No comparator",
        "Other"
      ]
    },
    "treatment_setting": {
      "type": "string",
      "enum": [
        "Neoadjuvant",
        "Adjuvant",
        "Maintenance",
        "First-line",
        "Second-line",
        "Later-line",
        "Relapsed",
        "Refractory",
        "Prevention",
        "Diagnostic",
        "Supportive care"
      ]
    },
    "trial_contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_name",
        "last_name",
        "email"
      ],
      "properties": {
        "first_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "ctis_country_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "label",
        "outcome"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "ctis_overall_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "label",
        "outcome",
        "country_code"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/nullable_string"
        },
        "country_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "ctis_country_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "updates"
      ],
      "properties": {
        "country_code": {
          "$ref": "#/$defs/country_code"
        },
        "updates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ctis_country_update"
          }
        }
      }
    },
    "extracted_document_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
